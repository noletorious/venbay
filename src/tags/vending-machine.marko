<let/credits=25>
<let/internalRow=input.initialRow ?? null>
<let/internalCol=input.initialCol ?? null>

<const/rows=["A", "B", "C", "D", "E"]/>
<const/cols=[1, 2, 3, 4, 5]/>
<const/row=input.row !== undefined ? input.row : internalRow/>
<const/col=input.col !== undefined ? input.col : internalCol/>
<const/selection=row && col ? `${row}${col}` : null/>

<div class="vending-machine">
  <div class="vending-machine__screen">
    <if=selection>
      <p class="vending-machine__screen-label">Selected</p>
      <p class="vending-machine__screen-value">${selection}</p>
    </if>
    <else>
      <p class="vending-machine__screen-label">Credits</p>
      <p class="vending-machine__screen-value">${credits}</p>
    </else>
  </div>

  <p class="vending-machine__hint">
    Need more credits? They top up automatically over time.
  </p>

  <div class="vending-machine__keypad">
    <for|r| of=rows>
      <button
        type="button"
        class=`vending-machine__key ${row === r ? "vending-machine__key--active" : input.hoverRow === r ? "vending-machine__key--hover-selected" : ""}`
        onClick() {
          if (input.onSelectRow) {
            input.onSelectRow(r);
          } else {
            internalRow = r;
          }
        }
      >
        ${r}
      </button>
    </for>
    <for|c| of=cols>
      <button
        type="button"
        class=`vending-machine__key ${col === c ? "vending-machine__key--active" : input.hoverCol === c ? "vending-machine__key--hover-selected" : ""}`
        onClick() {
          if (input.onSelectCol) {
            input.onSelectCol(c);
          } else {
            internalCol = c;
          }
        }
      >
        ${c}
      </button>
    </for>

    <div class="vending-machine__dispense">
      <venbay-button
        label="Dispense"
        icon="⏏"
        disabled=!input.onDispense || !selection
        onClick() {
          input.onDispense?.(selection);
        }
      />
    </div>
  </div>
</div>

<style>
  .vending-machine {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--border-color, #e5e5e5);
    border-radius: 12px;
  }

  .vending-machine__screen {
    background: #0d1b0f;
    color: #7dffa0;
    border-radius: 6px;
    padding: 0.75rem;
    text-align: center;
    font-family: "Courier New", monospace;
  }

  .vending-machine__screen-label {
    margin: 0;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.75;
  }

  .vending-machine__screen-value {
    margin: 0.125rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .vending-machine__hint {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .vending-machine__keypad {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--border-color, #e5e5e5);
    border: 1px solid var(--border-color, #e5e5e5);
    border-radius: 8px;
    overflow: hidden;
    flex: 1;
  }

  .vending-machine__key {
    aspect-ratio: 1;
    border: none;
    background: var(--bg-color);
    color: var(--text-color);
    font-family: "Courier New", monospace;
    font-weight: 700;
    font-size: 1.125rem;
    cursor: pointer;
    transition: filter 0.05s ease;
  }

  .vending-machine__key:hover {
    filter: brightness(0.92);
  }

  .vending-machine__key:active {
    filter: brightness(0.85);
  }

  .vending-machine__key--active {
    background: var(--card-accent, #4c9aff);
    color: #fff;
  }

  .vending-machine__key--hover-selected {
    box-shadow: inset 0 0 0 2px var(--card-accent, #4c9aff);
    color: var(--card-accent, #4c9aff);
  }

  .vending-machine__dispense {
    grid-column: 1 / -1;
    background: var(--bg-color);
  }

  .vending-machine__dispense button {
    width: 100%;
    border-radius: 0;
    box-shadow: none;
  }
</style>
