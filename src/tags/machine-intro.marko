client import * as THREE from "three";
client import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
client import machineUrl from "../../assets/venbay-machine.glb?url";

export interface Input {
  onEnter?: () => void;
}

<let/entering=false>
<let/api=null>

<div/container class=`machine-intro ${entering ? "machine-intro--entering" : ""}`>
  <div/canvasHost class="machine-intro__canvas"/>

  <div class="machine-intro__by">
    <span>by</span>
    <img src="../../assets/EBay_logo.svg.webp" alt="eBay" class="machine-intro__ebay-logo">
  </div>

  <div class="machine-intro__banner">
    <div class="machine-intro__cloud machine-intro__cloud--1"></div>
    <div class="machine-intro__cloud machine-intro__cloud--2"></div>
    <div class="machine-intro__cloud machine-intro__cloud--3"></div>
    <div class="machine-intro__cloud machine-intro__cloud--4"></div>

    <img src="../../assets/venbay.svg" alt="venbay" class="machine-intro__logo">
  </div>

  <button
    type="button"
    class="btn btn--primary machine-intro__enter"
    disabled=entering
    onClick() {
      entering = true;
      api?.beginZoom();
    }
  >
    Enter venbay
  </button>
</div>

<lifecycle
  onMount() {
    const el = canvasHost();

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      45,
      el.clientWidth / el.clientHeight,
      0.1,
      1000
    );
    const orbitPos = new THREE.Vector3(4, 1.4, 6);
    const orbitLookAt = new THREE.Vector3(0, -0.4, 0);
    const frontPos = new THREE.Vector3(0, 0.9, 2.1);
    const frontLookAt = new THREE.Vector3(0, 0.7, 0);
    camera.position.copy(orbitPos);
    camera.lookAt(orbitLookAt);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setClearColor(0x000000, 0);
    renderer.setSize(el.clientWidth, el.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    el.appendChild(renderer.domElement);

    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x444444, 1.2);
    scene.add(hemiLight);
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.position.set(5, 10, 7.5);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.set(1024, 1024);
    dirLight.shadow.camera.near = 1;
    dirLight.shadow.camera.far = 30;
    dirLight.shadow.camera.left = -5;
    dirLight.shadow.camera.right = 5;
    dirLight.shadow.camera.top = 5;
    dirLight.shadow.camera.bottom = -5;
    scene.add(dirLight);

    const shadowGround = new THREE.Mesh(
      new THREE.PlaneGeometry(20, 20),
      new THREE.ShadowMaterial({ opacity: 0.28 })
    );
    shadowGround.rotation.x = -Math.PI / 2;
    shadowGround.receiveShadow = true;
    scene.add(shadowGround);

    const orbitOffset = orbitPos.clone().sub(orbitLookAt);
    const orbitSpherical = new THREE.Spherical().setFromVector3(orbitOffset);
    const radius = orbitSpherical.radius;
    const polar = orbitSpherical.phi;
    const profileStart = orbitSpherical.theta;
    const profileEnd = -orbitSpherical.theta;

    let azimuth = profileStart;
    let radiusOffset = 0;
    let rotateTween = { from: profileStart, to: profileEnd, start: performance.now(), duration: 4000 };

    const easeOutCubic = (p) => 1 - Math.pow(1 - p, 3);

    const applyOrbitCamera = () => {
      const offset = new THREE.Vector3().setFromSpherical(
        new THREE.Spherical(radius + radiusOffset, polar, azimuth)
      );
      camera.position.copy(orbitLookAt).add(offset);
      camera.lookAt(orbitLookAt);
    };
    applyOrbitCamera();

    let isDragging = false;
    let lastPointerX = 0;
    const DRAG_SENSITIVITY = 0.006;

    const onPointerDown = (e) => {
      isDragging = true;
      rotateTween = null;
      lastPointerX = e.clientX;
      renderer.domElement.setPointerCapture(e.pointerId);
    };
    const onPointerMove = (e) => {
      if (!isDragging) return;
      const dx = e.clientX - lastPointerX;
      lastPointerX = e.clientX;
      azimuth += dx * DRAG_SENSITIVITY;
      applyOrbitCamera();
    };
    const onPointerUp = () => {
      if (!isDragging) return;
      isDragging = false;
      rotateTween = { from: azimuth, to: profileEnd, start: performance.now(), duration: 1600 };
    };
    renderer.domElement.addEventListener("pointerdown", onPointerDown);
    renderer.domElement.addEventListener("pointermove", onPointerMove);
    renderer.domElement.addEventListener("pointerup", onPointerUp);

    const onWheel = (e) => {
      e.preventDefault();
      radiusOffset = Math.max(-1, Math.min(1.5, radiusOffset + e.deltaY * 0.002));
      applyOrbitCamera();
    };
    renderer.domElement.addEventListener("wheel", onWheel, { passive: false });

    const loader = new GLTFLoader();
    loader.load(machineUrl, (gltf) => {
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3());
      const center = box.getCenter(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z) || 1;
      const scale = 3 / maxDim;
      model.scale.setScalar(scale);
      model.position.copy(center).multiplyScalar(-scale);
      model.traverse((node) => {
        if (node.isMesh) {
          node.castShadow = true;
        }
      });
      shadowGround.position.y = (-size.y / 2) * scale;
      scene.add(model);
    });

    let frameId;
    let zoomStart = null;
    let zoomFromPos = orbitPos;
    const ZOOM_MS = 1400;

    const animate = (t) => {
      frameId = requestAnimationFrame(animate);

      if (zoomStart !== null) {
        const p = Math.min((t - zoomStart) / ZOOM_MS, 1);
        const eased = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        camera.position.lerpVectors(zoomFromPos, frontPos, eased);
        camera.lookAt(orbitLookAt.clone().lerp(frontLookAt, eased));
        if (p > 0.6) {
          container().style.setProperty("--intro-fade", String((p - 0.6) / 0.4));
        }
        if (p === 1) {
          zoomStart = null;
        }
      } else if (!isDragging) {
        if (rotateTween) {
          const p = Math.min((t - rotateTween.start) / rotateTween.duration, 1);
          azimuth = rotateTween.from + (rotateTween.to - rotateTween.from) * easeOutCubic(p);
          if (p === 1) {
            rotateTween = null;
          }
        }
        applyOrbitCamera();
      }

      renderer.render(scene, camera);
    };
    animate(performance.now());

    const onResize = () => {
      camera.aspect = el.clientWidth / el.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(el.clientWidth, el.clientHeight);
    };
    window.addEventListener("resize", onResize);

    api = {
      beginZoom: () => {
        rotateTween = null;
        zoomFromPos = camera.position.clone();
        zoomStart = performance.now();
        setTimeout(() => {
          input.onEnter?.();
        }, ZOOM_MS + 500);
      },
      cleanup: () => {
        cancelAnimationFrame(frameId);
        window.removeEventListener("resize", onResize);
        renderer.domElement.removeEventListener("pointerdown", onPointerDown);
        renderer.domElement.removeEventListener("pointermove", onPointerMove);
        renderer.domElement.removeEventListener("pointerup", onPointerUp);
        renderer.domElement.removeEventListener("wheel", onWheel);
        renderer.dispose();
        el.removeChild(renderer.domElement);
      },
    };
  }
  onDestroy() {
    api?.cleanup();
  }
/>

<style>
  .machine-intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg-color);
    --intro-fade: 0;
    opacity: calc(1 - var(--intro-fade));
    transition: opacity 0.5s ease;
  }

  .machine-intro--entering {
    pointer-events: none;
  }

  .machine-intro__canvas {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .machine-intro__canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
  }

  .machine-intro__canvas canvas:active {
    cursor: grabbing;
  }

  .machine-intro__banner {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    z-index: 0;
  }

  .machine-intro__logo {
    height: 120px;
    width: auto;
    position: relative;
    z-index: 1;
  }

  .machine-intro__by {
    position: absolute;
    left: 50%;
    bottom: calc(10% + 4.5rem);
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--text-color);
    opacity: 0.8;
  }

  .machine-intro__ebay-logo {
    height: 16px;
    width: auto;
  }

  .machine-intro__cloud {
    position: absolute;
    background: #fff;
    border-radius: 999px;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.08));
    animation: machine-intro-drift 9s ease-in-out infinite;
  }

  @keyframes machine-intro-drift {
    0%, 100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(18px);
    }
  }

  .machine-intro__cloud::before,
  .machine-intro__cloud::after {
    content: "";
    position: absolute;
    background: #fff;
    border-radius: 999px;
  }

  .machine-intro__cloud--1 {
    width: 110px;
    height: 40px;
    top: 10px;
    left: -60px;
    animation-duration: 10s;
  }
  .machine-intro__cloud--1::before {
    width: 54px;
    height: 54px;
    top: -26px;
    left: 12px;
  }
  .machine-intro__cloud--1::after {
    width: 40px;
    height: 40px;
    top: -16px;
    left: 58px;
  }

  .machine-intro__cloud--2 {
    width: 80px;
    height: 30px;
    top: 60px;
    left: -45px;
    z-index: 2;
    animation-duration: 13s;
    animation-delay: -3s;
  }
  .machine-intro__cloud--2::before {
    width: 38px;
    height: 38px;
    top: -18px;
    left: 8px;
  }
  .machine-intro__cloud--2::after {
    width: 28px;
    height: 28px;
    top: -10px;
    left: 40px;
  }

  .machine-intro__cloud--3 {
    width: 120px;
    height: 44px;
    top: 0;
    right: -70px;
    animation-duration: 11s;
    animation-delay: -5s;
  }
  .machine-intro__cloud--3::before {
    width: 58px;
    height: 58px;
    top: -28px;
    left: 14px;
  }
  .machine-intro__cloud--3::after {
    width: 38px;
    height: 38px;
    top: -14px;
    left: 66px;
  }

  .machine-intro__cloud--4 {
    width: 52px;
    height: 20px;
    top: 70px;
    right: 0px;
    z-index: 2;
    animation-duration: 9s;
    animation-delay: -1.5s;
  }
  .machine-intro__cloud--4::before {
    width: 25px;
    height: 25px;
    top: -12px;
    left: 5px;
  }
  .machine-intro__cloud--4::after {
    width: 18px;
    height: 18px;
    top: -6px;
    left: 27px;
  }

  .machine-intro__enter {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 10%;
    transform: translateX(-50%);
    cursor: pointer;
  }

  .machine-intro__enter:disabled {
    cursor: default;
  }
</style>
