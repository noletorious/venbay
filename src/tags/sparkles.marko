static const DEFAULT_COLOR = "#FFC700";
static const SPARKLE_LIFETIME = 750;
static const SPARKLE_PATH =
  "M26.5 25.5C19.0043 33.3697 0 34 0 34C0 34 19.1013 35.3684 26.5 43.5C33.234 50.901 34 68 34 68C34 68 36.9884 50.7065 44.5 43.5C51.6431 36.647 68 34 68 34C68 34 51.6947 32.0939 44.5 25.5C36.5605 18.2235 34 0 34 0C34 0 33.6591 17.9837 26.5 25.5Z";

static function random(min, max) {
  return Math.floor(Math.random() * (max - min)) + min;
}

static function generateSparkle(color) {
  const createdAt = Date.now();
  return {
    id: `${createdAt}-${random(0, 999999)}`,
    createdAt,
    color,
    size: random(10, 20),
    top: random(-20, 80) + "%",
    left: random(-20, 80) + "%",
  };
}

<let/sparkles=[]>

<const/color=input.color || DEFAULT_COLOR/>

<lifecycle
  onMount() {
    const reduceMotion =
      typeof window !== "undefined" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduceMotion) {
      return;
    }

    let timeoutId;
    const tick = () => {
      if (input.enabled ?? true) {
        const now = Date.now();
        sparkles = sparkles
          .filter((s) => now - s.createdAt < SPARKLE_LIFETIME)
          .concat(generateSparkle(color));
      } else if (sparkles.length) {
        sparkles = [];
      }
      timeoutId = setTimeout(tick, random(50, 450));
    };

    tick();
    return { clear: () => clearTimeout(timeoutId) };
  }
  onDestroy() {
    this?.clear();
  }
/>

<span class="sparkles">
  <span class="sparkles__content">
    <${input.content}/>
  </span>
  <for|s| of=sparkles by="id">
    <span class="sparkles__sparkle" style=`top:${s.top};left:${s.left}`>
      <svg width=s.size height=s.size viewBox="0 0 68 68" fill="none">
        <path d=SPARKLE_PATH fill=s.color/>
      </svg>
    </span>
  </for>
</span>

<style>
  .sparkles {
    position: relative;
    display: inline-block;
    overflow: visible;
  }

  .sparkles__content {
    position: relative;
    z-index: 1;
  }

  .sparkles__sparkle {
    position: absolute;
    z-index: 2;
    display: block;
    pointer-events: none;
    animation: sparkles-pop 0.7s ease-in-out forwards;
  }

  @keyframes sparkles-pop {
    0% {
      transform: scale(0) rotate(0deg);
    }
    50% {
      transform: scale(1) rotate(90deg);
    }
    100% {
      transform: scale(0) rotate(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkles__sparkle {
      display: none;
    }
  }
</style>
