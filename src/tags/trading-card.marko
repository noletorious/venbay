<const/name=input.card.alt_description || input.card.description || "Untitled"/>
<const/photographer=input.card.user.name/>

<div
  class=`trading-card ${input.rare ? "trading-card--rare" : ""}`
  style=`--card-accent:${input.card.color}`
  role="button"
  tabindex="0"
  aria-label=`View ${name}, code ${input.code}`
  onClick() {
    input.onSelect?.(input.card, input.code);
  }
  onKeydown(e) {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      input.onSelect?.(input.card, input.code);
    }
  }
>
  <div class="trading-card__frame">
    <div class="trading-card__header">
      <p class="trading-card__name">${name}</p>
    </div>

    <div class="trading-card__image-wrap">
      <img src=input.card.urls.small alt=name class="trading-card__image">
      <span class="trading-card__code">${input.code}</span>
    </div>

    <div class="trading-card__footer">
      <span class="trading-card__type">Photo Card</span>
      <span class="trading-card__dims">${input.card.width}×${input.card.height}</span>
    </div>

    <div class="trading-card__meta-row">
      <span class="trading-card__hp">♥ ${input.card.likes}</span>
      <a
        href=`${input.card.links.html}?utm_source=venbay&utm_medium=referral`
        target="_blank"
        rel="noopener"
        class="trading-card__credit"
        onClick(e) {
          e.stopPropagation();
        }
      >
        Photo by ${photographer} on Unsplash
      </a>
    </div>
  </div>
</div>

<style>
  .trading-card {
    max-width: 260px;
    padding: 3px;
    border-radius: 12px;
    background: linear-gradient(160deg, var(--card-accent, #ccc), transparent 60%);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .trading-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
  }

  .trading-card:focus-visible {
    outline: 2px solid var(--card-accent, #4c9aff);
    outline-offset: 2px;
  }

  .trading-card__frame {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.5rem;
    border-radius: 10px;
    background: var(--bg-color);
  }

  .trading-card__header {
    margin: -0.5rem -0.5rem 0;
    padding: 0.4rem 0.5rem;
    border-radius: 10px 10px 0 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--card-accent, #ccc) 45%, var(--bg-color)),
      var(--bg-color) 85%
    );
  }

  .trading-card__name {
    margin: 0;
    color: var(--card-title-color, var(--text-color));
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .trading-card--rare .trading-card__header {
    background: var(--card-accent, #ccc);
  }

  .trading-card--rare .trading-card__name {
    --card-title-color: #fff;
  }

  .trading-card__image-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--card-accent, var(--border-color, #e5e5e5));
    background: var(--hover-bg);
  }

  .trading-card__code {
    position: absolute;
    bottom: 0;
    right: 0;
    padding: 0.25rem 0.75rem;
    border-radius: 4px 0 0 0;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-family: "Courier New", monospace;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .trading-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .trading-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .trading-card__type {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.125rem 0.4rem;
    border-radius: 999px;
    background: var(--card-accent, var(--hover-bg));
    color: #fff;
  }

  .trading-card__dims {
    font-size: 0.6875rem;
    opacity: 0.6;
  }

  .trading-card__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .trading-card__hp {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--card-accent, currentColor);
  }

  .trading-card__credit {
    min-width: 0;
    font-size: 0.5625rem;
    opacity: 0.5;
    text-align: right;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .trading-card__credit:hover {
    opacity: 0.85;
    text-decoration: underline;
  }
</style>
