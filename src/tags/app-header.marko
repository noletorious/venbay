client import { getPurchasedCards } from "../lib/purchased-cards";

<const/suggestions=[
  "nature", "architecture", "animals", "ocean", "mountains",
  "city", "food", "technology", "space", "abstract", "travel", "minimal",
]/>

<let/searching=input.searching ?? false>
<let/theme="light">
<let/query=input.query || ""/>
<let/showSuggestions=input.showSuggestions ?? false>
<let/hasPurchasedCards=false>

<script>
  hasPurchasedCards = getPurchasedCards().length > 0;
</script>

<const/filteredSuggestions=suggestions
  .filter((s) => s.toLowerCase().includes(query.toLowerCase()))
  .slice(0, 6)/>

<header class="app-header">
  <div class="app-header__left">
    <if=searching>
      <span class="app-header__search-label">Search</span>
    </if>
    <else>
      <img src="../assets/venbay.svg" alt="venbay" class="app-header__logo">
    </else>
  </div>

  <div class="app-header__center">
    <if=searching>
      <form
        class="app-header__search-form"
        method="GET"
        action="/"
      >
        <input
          type="text"
          name="q"
          class="app-header__search-input"
          placeholder="Search photo cards..."
          value=query
          autofocus
          autocomplete="off"
          onInput(e) {
            query = e.target.value;
            showSuggestions = true;
          }
          onFocus() {
            showSuggestions = true;
          }
          onBlur() {
            showSuggestions = false;
          }
        >
        <if=(showSuggestions && filteredSuggestions.length)>
          <ul class="app-header__suggestions">
            <for|s| of=filteredSuggestions>
              <li>
                <button
                  type="submit"
                  name="q"
                  value=s
                  class="app-header__suggestion"
                >
                  ${s}
                </button>
              </li>
            </for>
          </ul>
        </if>
      </form>
    </if>
    <else-if=query>
      <div class="app-header__query-pill">
        <button
          type="button"
          class="app-header__query-label"
          onClick() {
            searching = true;
          }
        >
          Search: ${query}
        </button>
        <a href="/" class="app-header__query-clear" aria-label="Clear search">✕</a>
      </div>
    </else-if>
  </div>

  <div class="app-header__right">
    <if=searching>
      <button
        type="button"
        class="app-header__icon-btn"
        aria-label="Close search"
        onClick() {
          searching = false;
          query = input.query || "";
        }
      >
        ✕
      </button>
    </if>
    <else>
      <if=hasPurchasedCards>
        <a href="/my-cards" class="app-header__icon-btn" aria-label="My cards">
          🎴
        </a>
      </if>
      <button
        type="button"
        class="app-header__icon-btn"
        aria-label="Toggle theme"
        onClick() {
          theme = theme === "light" ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
        }
      >
        ◐
      </button>
      <button
        type="button"
        class="app-header__icon-btn app-header__icon-btn--search"
        aria-label="Open search"
        onClick() {
          searching = true;
        }
      >
        ⌕
      </button>
    </else>
  </div>
</header>

<style>
  .app-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-height, 64px);
    padding: 0 1rem;
    border-bottom: 1px solid var(--border-color, #e5e5e5);
  }

  .app-header__left,
  .app-header__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1 0 0;
  }

  .app-header__right {
    justify-content: flex-end;
  }

  .app-header__center {
    flex: 2 0 0;
    display: flex;
    justify-content: center;
  }

  .app-header__logo {
    height: 24px;
    width: auto;
  }

  .app-header__search-label {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .app-header__search-form {
    position: relative;
    width: 100%;
    max-width: 480px;
  }

  .app-header__search-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-color, #e5e5e5);
    border-radius: 4px;
    font-size: 1rem;
    background: var(--bg-color);
    color: var(--text-color);
  }

  .app-header__query-pill {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.375rem 0.375rem 0.75rem;
    border: 1px solid var(--border-color, #e5e5e5);
    border-radius: 999px;
    background: var(--hover-bg);
  }

  .app-header__query-label {
    border: none;
    background: transparent;
    color: var(--text-color);
    font-size: 0.875rem;
    cursor: pointer;
    padding: 0;
  }

  .app-header__query-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.75rem;
  }

  .app-header__query-clear:hover {
    background: var(--border-color, rgba(0, 0, 0, 0.1));
  }

  .app-header__suggestions {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--bg-color);
    border: 1px solid var(--border-color, #e5e5e5);
    border-radius: 6px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    z-index: 10;
  }

  .app-header__suggestion {
    display: block;
    width: 100%;
    padding: 0.5rem 0.625rem;
    border: none;
    background: transparent;
    color: var(--text-color);
    text-align: left;
    font-size: 0.875rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .app-header__suggestion:hover {
    background: var(--hover-bg);
  }

  .app-header__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    border-radius: 50%;
    font-size: 1.125rem;
    cursor: pointer;
  }

  .app-header__icon-btn:hover {
    background: var(--hover-bg, rgba(0, 0, 0, 0.06));
  }

  .app-header__icon-btn--search {
    width: 1em;
    height: 1em;
    font-size: 2rem;
  }
</style>
