<const/rowLetters=["A", "B", "C", "D", "E"]/>

<div class="card-grid">
  <for|card, i| of=input.cards>
    <trading-card
      card=card
      code=`${rowLetters[Math.floor(i / 5)] || "?"}${(i % 5) + 1}`
    />
  </for>
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 700px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
