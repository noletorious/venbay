client import { getCredits } from "../lib/credits";
import { getCardCost } from "../lib/card-cost";

<let/selectedRow=null>
<let/selectedCol=null>
<let/hoverRow=null>
<let/hoverCol=null>
<let/credits=25>

<script>
  credits = getCredits();
</script>

<const/rowLetters=["A", "B", "C", "D", "E"]/>

<main class="home">
  <await|cards|=$global.data.cards>
    <const/codeToId=Object.fromEntries(
      cards.map((c, i) => [`${rowLetters[Math.floor(i / 5)]}${(i % 5) + 1}`, c.id])
    )/>
    <const/minCost=cards.length ? Math.min(...cards.map(getCardCost)) : 0/>

    <div class="home__cards">
      <card-grid
        cards=cards
        onHover(card, code) {
          hoverRow = code[0];
          hoverCol = Number(code.slice(1));
        }
        onLeaveHover() {
          hoverRow = null;
          hoverCol = null;
        }
      />
    </div>

    <aside class="home__machine">
      <vending-machine
        row=selectedRow
        col=selectedCol
        hoverRow=hoverRow
        hoverCol=hoverCol
        credits=credits
        minCost=minCost
        onSelectRow(r) {
          selectedRow = r;
          const code = `${r}${selectedCol}`;
          const id = selectedCol && codeToId[code];
          if (id) {
            window.location.href = `/card/${id}?code=${code}`;
          }
        }
        onSelectCol(c) {
          selectedCol = c;
          const code = `${selectedRow}${c}`;
          const id = selectedRow && codeToId[code];
          if (id) {
            window.location.href = `/card/${id}?code=${code}`;
          }
        }
      />
    </aside>
  </await>
</main>

<style>
  .home {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
  }

  .home__cards {
    flex: 3 0 0;
    min-width: 0;
  }

  .home__machine {
    flex: 0 0 320px;
    position: sticky;
    top: calc(var(--header-height, 64px) + 1rem);
    height: calc(100vh - var(--header-height, 64px) - 2rem);
    padding-bottom: 2rem;
    box-sizing: border-box;
  }

  @media (min-width: 701px) and (max-width: 900px) {
    .home__machine {
      flex-basis: 240px;
    }
  }

  @media (max-width: 700px) {
    .home {
      flex-direction: column;
    }

    .home__cards {
      flex: none;
      width: 100%;
      overflow-y: hidden;
      padding-bottom: 320px;
    }

    .home__machine {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: auto;
      max-height: 60vh;
      padding: 0.75rem;
      background: var(--bg-color);
      border-top: 1px solid var(--border-color, #e5e5e5);
      z-index: 50;
    }
  }
</style>
