client import { addPurchasedCard } from "../../../lib/purchased-cards";
client import { getCredits, spendCredits } from "../../../lib/credits";
import { getCardCost } from "../../../lib/card-cost";

<const/card=$global.data.card/>
<const/code=$global.data.code/>
<const/cost=card ? getCardCost(card) : 0/>

<let/credits=25>

<script>
  credits = getCredits();
</script>

<main class="detail">
  <div class="detail__content">
    <a href="/" class="detail__back">← Back to list</a>

    <if=card>
      <p class="detail__notice">
        Confirm the code
        <strong class="detail__notice-code">${code || "?"}</strong>
        on the keypad and hit dispense to purchase this card.
      </p>

      <trading-card card=card code=code detailed=true/>
    </if>
    <else>
      <p>Couldn't find that card. It may have already been dispensed.</p>
    </else>
  </div>

  <aside class="detail__machine">
    <vending-machine
      initialRow=code ? code[0] : null
      initialCol=code ? Number(code.slice(1)) : null
      locked=!!code
      credits=credits
      minCost=cost
      onCreditsChange(next) { credits = next; }
      onDispense() {
        addPurchasedCard(card, code);
        spendCredits(cost);
        window.location.href = "/my-cards";
      }
    />
  </aside>
</main>

<style>
  .detail {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
  }

  .detail__content {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .detail__back {
    color: var(--text-color);
    opacity: 0.7;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .detail__back:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .detail__notice {
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color, #e5e5e5);
    border-radius: 8px;
    background: var(--hover-bg);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .detail__notice-code {
    font-family: "Courier New", monospace;
    font-size: 1.0625rem;
    letter-spacing: 0.05em;
  }

  .detail__machine {
    flex: 0 0 320px;
    position: sticky;
    top: calc(var(--header-height, 64px) + 1rem);
    height: calc(100vh - var(--header-height, 64px) - 2rem);
    padding-bottom: 2rem;
    box-sizing: border-box;
  }

  @media (min-width: 701px) and (max-width: 900px) {
    .detail__machine {
      flex-basis: 240px;
    }
  }

  @media (max-width: 700px) {
    .detail {
      flex-direction: column;
    }

    .detail__content {
      padding-bottom: 320px;
    }

    .detail__machine {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: auto;
      max-height: 60vh;
      padding: 0.75rem;
      background: var(--bg-color);
      border-top: 1px solid var(--border-color, #e5e5e5);
      z-index: 50;
    }
  }
</style>
